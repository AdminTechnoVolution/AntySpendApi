NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/antyspend
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
EXCHANGE_RATE_API_TOKEN=
RATE_LIMIT_MAX=50
RATE_LIMIT_TTL_MS=60000
# Set to true to expose /docs and OpenAPI JSON (off by default)
ENABLE_SWAGGER=false
# Google Play Billing (subscriptions verification)
GOOGLE_PLAY_PACKAGE_NAME=com.technovolution.antyspend
# Production (Azure App Settings): Base64 from `npm run billing:encode-sa -- /path/to/play-sa.json`
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
# Local dev: filesystem path to Play Console service account JSON (leave BASE64 empty)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/path/to/play-service-account.json
# Real-time developer notifications (Pub/Sub push)
RTDN_ENABLED=true
GOOGLE_PUBSUB_PUSH_AUDIENCE=https://api.antyspend.com/webhooks/google-play/rtdn
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=your-api-sa@your-project.iam.gserviceaccount.com
RTDN_SKIP_AUTH=false
